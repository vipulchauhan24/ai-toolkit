    "prompt": "Use the ai-toolkit:spec-writer skill on missing.md. Work non-interactively: do not ask questions.",
    "tools": "Read,Glob,Grep,Skill,Write,Edit,Bash(python3:*)",
    "skills": [
      "spec-writer"
    ],
    "must": [
      "(?i)blocked",
      "missing\\.md"
