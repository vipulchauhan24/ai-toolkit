[
  {
    "id": "spec-writer-brief-noninteractive",
    "tier": "slow",
    "fixture": "spec-writer-projects",
    "covers": [
      "skills/spec-writer",
      "skills/spec-writer/references/markdown-rules.md"
    ],
    "source": "spec-writer.md: Functional / Brief, no questions possible",
    "prompt": "Use the ai-toolkit:spec-writer skill on brief.md. Work non-interactively: do not ask questions. Then reply with the skill's report.",
    "tools": "Read,Glob,Grep,Skill,Write,Edit,Bash(python3:*),Bash(git:*),Bash(date:*)",
    "skills": [
      "spec-writer"
    ],
    "reads": [
      "spec-template\\.md",
      "markdown-rules\\.md",
      "check_spec\\.py"
    ],
    "must": [
      "spec\\.md"
    ],
    "files": [
      {
        "glob": "spec.md",
        "must": [
          "(?m)^## Open questions",
          "Undecided",
          "ask me first",
          "Assumption",
          "(?m)^## Assumptions to confirm"
        ],
        "must_not": [
          "(?m)^- Status: ready to plan"
        ]
      }
    ],
    "unchanged": [
      "brief.md"
    ],
    "post": [
      "python3 -I {repo}/skills/spec-writer/scripts/check_spec.py spec.md"
    ]
  },
  {
    "id": "spec-writer-keeps-answers",
    "tier": "slow",
    "fixture": "spec-writer-projects",
    "covers": [
      "skills/spec-writer"
    ],
    "source": "spec-writer.md: Functional / Spec with gaps",
    "prompt": "Use the ai-toolkit:spec-writer skill on partial-spec.md. Work non-interactively: do not ask questions. Then reply with the skill's report.",
    "tools": "Read,Glob,Grep,Skill,Write,Edit,Bash(python3:*),Bash(git:*),Bash(date:*)",
    "skills": [
      "spec-writer"
    ],
    "files": [
      {
        "glob": "spec.md",
        "must": [
          "# Sample Service - Spec",
          "A small service that stores orders and reports counts, used by the checkout page\\.",
          "Save order - must-have - Done when: a valid order returns 201 in under 200 ms"
        ]
      }
    ],
    "unchanged": [
      "partial-spec.md"
    ],
    "post": [
      "python3 -I {repo}/skills/spec-writer/scripts/check_spec.py spec.md"
    ]
  },
  {
