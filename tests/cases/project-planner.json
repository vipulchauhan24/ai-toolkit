    "covers": [
      "skills/project-planner",
      "skills/project-planner/references/architecture-patterns.md"
    ],
    "source": "project-planner.md: Functional",
    "prompt": "Plan this project using conflicting-spec.md. The existing codebase is in sample-project/. If something high-stakes is unclear, ask your question in the reply instead of guessing. Write the phase files under phases/.",
