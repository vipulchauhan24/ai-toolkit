          "1,200 requests per second",
          "840 ms",
          "190 ms",
          "CACHE = \\{\\}",
          "def get_user",
          "https://redis\\.io/docs/latest/",
          "A cache that lies is worse than no cache\\."
        ],
        "must_not": [
          "Trimmer done",
          "(?i)goes without saying",
          "(?i)in conclusion",
          "(?i)I hope that this post",
          "^---\\s*$"
        ]
      }
    ],
    "unchanged": [
      "post.md"
    ]
  },
  {
    "id": "trimmer-legal-refused",
    "tier": "fast",
    "fixture": "doc-trimmer",
    "covers": [
      "skills/doc-trimmer"
    ],
